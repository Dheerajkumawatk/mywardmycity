# =============================================================================
# mycitymyward — environment configuration
# Copy this file to `.env.local` for local development. Never commit real values.
# =============================================================================

# --- Site -------------------------------------------------------------------
# Public base URL, used for canonical tags, sitemap, Open Graph and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Human-readable site name (kept in env so legal/publisher text can be swapped
# without a code change).
NEXT_PUBLIC_SITE_NAME="mycitymyward"

# --- Data collection master switch ----------------------------------------
# Citizen-issue and volunteer forms stay in "preview" mode (validation only, no
# storage, no reference number claiming municipal registration) until this is
# explicitly set to "true" AND a real privacy policy + authorised backend exist.
FEATURE_FORMS_ENABLED="false"

# --- Database -------------------------------------------------------------
# SQLite for local dev. Swap for a PostgreSQL URL in production, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/mycitymyward?schema=public
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./prisma/dev.db"

# --- Security ------------------------------------------------------------
# 32+ byte random string. Generate with: openssl rand -base64 48
# Used to sign the CSRF double-submit token and to derive the field-level
# encryption key for stored contact details.
APP_SECRET="replace-with-a-long-random-string-at-least-32-bytes"

# AES-256-GCM key (base64, 32 bytes) for encrypting sensitive submission fields
# (name, phone, email) at rest. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# --- Rate limiting -----------------------------------------------------
# Requests allowed per window per IP for form endpoints.
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="600"

# --- Google Maps (optional, consent-aware embed) --------------------
# Public embed key. MUST be restricted by HTTP referrer (your domain) and to the
# "Maps Embed API" only in Google Cloud Console. Leave blank to fall back to the
# static link + text alternative.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# Approximate map centre for Ward 110 / Kishanpol (indicative only — replace with
# coordinates confirmed against the official JMC ward map before deployment).
NEXT_PUBLIC_WARD_MAP_LAT="26.9239"
NEXT_PUBLIC_WARD_MAP_LNG="75.8107"

# --- Headless CMS (optional) ----------------------------------------
# If a CMS is connected, set the endpoint + read token. When unset, the site
# renders from the typed files in /data.
CMS_API_URL=""
CMS_API_TOKEN=""

# --- Analytics (optional, privacy-friendly only) ------------------
# e.g. a self-hosted Plausible / Umami domain. Leave blank to ship zero analytics.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SRC=""

# --- Uploads (optional, only used when FEATURE_FORMS_ENABLED=true) ---
# Object-storage bucket for citizen-issue image attachments. When unset, the
# issue text is still recorded but attachments are dropped (never stored
# insecurely). Implement the write in app/api/issues/route.ts -> persistUploads().
UPLOAD_STORAGE_BUCKET=""

# --- Notifications (optional) --------------------------------------
# Where new (approved) citizen-issue notifications are emailed once a backend is
# authorised. SMTP settings intentionally omitted until forms go live.
ISSUE_NOTIFY_EMAIL=""

# --- Supabase (leads + admin auth) --------------------------------------
# Project URL and publishable (anon) key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
